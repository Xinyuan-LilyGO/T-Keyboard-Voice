{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "T-Keyboard Voice: Build",
            "type": "process",
            "command": "platformio",
            "windows": {
                "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe"
            },
            "args": ["run", "--project-dir", "${workspaceFolder}", "--environment", "${input:pioEnvironment}"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        },
        {
            "label": "T-Keyboard Voice: Upload",
            "type": "process",
            "command": "platformio",
            "windows": {
                "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe"
            },
            "args": ["run", "--project-dir", "${workspaceFolder}", "--environment", "${input:pioEnvironment}", "--target", "upload"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": ["$gcc"],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        },
        {
            "label": "T-Keyboard Voice: Clean",
            "type": "process",
            "command": "platformio",
            "windows": {
                "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe"
            },
            "args": ["run", "--project-dir", "${workspaceFolder}", "--environment", "${input:pioEnvironment}", "--target", "clean"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "T-Keyboard Voice: Monitor",
            "type": "process",
            "command": "platformio",
            "windows": {
                "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe"
            },
            "args": ["device", "monitor", "--environment", "${input:pioEnvironment}", "--baud", "115200"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": [],
            "presentation": {"reveal": "always", "panel": "dedicated"}
        }
    ],
    "inputs": [
        {
            "id": "pioEnvironment",
            "type": "pickString",
            "description": "选择构建环境；factory 为包含 18 项测试的整机固件",
            "options": ["factory", "power", "display", "keys", "ws2812", "audio_playback", "audio_record", "qwiic"],
            "default": "factory"
        }
    ]
}
